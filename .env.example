# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server酱 SendKey（必填）
# Server酱 Turbo：SCT 开头；Server酱³：sctp 开头
SERVERCHAN_SENDKEY=SCTxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：显式指定推送地址（一般不用填，脚本会自动识别 SendKey 类型）
# SERVERCHAN_API_URL=https://sctapi.ftqq.com/SCTxxxxxxxx.send

# opencode 配置
OPENCODE_MODEL=deepseek/deepseek-flash
# OPENCODE_BIN=/home/youruser/.opencode/bin/opencode

# 清理策略：报告和日志都只存在服务器
REPORT_KEEP_DAYS=7
LOG_KEEP_DAYS=14

# 报告时区（默认北京时间）
# REPORT_TZ=Asia/Shanghai

# 海外服务器需要代理时取消注释；scan.py 会自动读取
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
